<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Athletica Z Fitness — Matrículas Abertas | 8 Unidades em Manaus</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap');

:root{
  --void:#0B0B0D;
  --carbon:#17181C;
  --carbon-2:#1F2025;
  --z-red:#E8262F;
  --ignition:#FF7A29;
  --pulse:#FF2E7E;
  --steel:#F2F2F0;
  --smoke:#9A9DA5;
  --line: rgba(242,242,240,0.10);
  --ring: conic-gradient(from 200deg, var(--z-red), var(--ignition), var(--pulse), var(--z-red));
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
html,body{margin:0;padding:0;background:var(--void);color:var(--steel);font-family:'Manrope',sans-serif;-webkit-font-smoothing:antialiased;}
img,svg{display:block;max-width:100%;}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px;}
.eyebrow{font-family:'Space Mono',monospace;font-size:12px;letter-spacing:.18em;text-transform:uppercase;color:var(--ignition);margin:0 0 12px;}
h1,h2,h3{font-family:'Anton',sans-serif;font-weight:400;text-transform:uppercase;letter-spacing:.01em;margin:0;}
p{color:var(--smoke);line-height:1.65;font-size:15.5px;margin:0;}
a{color:inherit;}
::selection{background:var(--z-red);color:var(--steel);}

@media (prefers-reduced-motion: reduce){
  *{animation-duration:0.001s !important; animation-iteration-count:1 !important; transition-duration:0.001s !important;}
}

/* ---------- TOP BAR ---------- */
.topbar{position:sticky;top:0;z-index:50;background:rgba(11,11,13,0.86);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);}
.topbar-in{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;max-width:1120px;margin:0 auto;}
.brand{display:flex;align-items:center;gap:10px;}
.brand .mini-ring{width:34px;height:34px;border-radius:50%;background:var(--ring);display:flex;align-items:center;justify-content:center;padding:3px;flex-shrink:0;}
.brand .mini-ring-inner{width:100%;height:100%;border-radius:50%;background:var(--void);display:flex;align-items:center;justify-content:center;}
.brand .mini-ring-inner span{font-family:'Anton',sans-serif;font-size:15px;transform:skewX(-6deg);}
.brand-name{font-family:'Anton',sans-serif;font-size:15px;letter-spacing:.02em;line-height:1;}
.brand-name b{color:var(--z-red);}
.topbar-cta{font-family:'Space Mono',monospace;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;background:var(--z-red);color:var(--steel);padding:10px 18px;border-radius:999px;text-decoration:none;white-space:nowrap;transition:transform .15s ease, box-shadow .15s ease;box-shadow:0 0 0 rgba(232,38,47,0);}
.topbar-cta:hover{transform:translateY(-1px);box-shadow:0 8px 22px rgba(232,38,47,0.35);}

/* ---------- HERO ---------- */
.hero{min-height:88vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;border-bottom:1px solid var(--line);position:relative;overflow:hidden;padding:100px 24px 70px;background:var(--void);}
.hero::before{content:'';position:absolute;inset:0;background:
  radial-gradient(circle at 50% 20%, rgba(232,38,47,0.20), transparent 45%),
  radial-gradient(circle at 75% 75%, rgba(255,46,126,0.12), transparent 40%),
  radial-gradient(circle at 15% 70%, rgba(255,122,41,0.10), transparent 40%);
  pointer-events:none;}
.ring-hero{width:150px;height:150px;border-radius:50%;background:var(--ring);display:flex;align-items:center;justify-content:center;padding:7px;margin-bottom:24px;position:relative;z-index:1;animation:spin 14s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.ring-hero-inner{width:100%;height:100%;border-radius:50%;background:var(--void);display:flex;align-items:center;justify-content:center;}
.z-mark{font-family:'Anton',sans-serif;font-size:60px;color:var(--steel);transform:skewX(-6deg);animation:counterspin 14s linear infinite;}
@keyframes counterspin{to{transform:skewX(-6deg) rotate(-360deg);}}
.hero-eyebrow{position:relative;z-index:1;font-family:'Space Mono',monospace;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--ignition);margin-bottom:14px;}
.hero h1{font-size:clamp(38px,7.4vw,84px);line-height:0.92;position:relative;z-index:1;}
.hero h1 span{color:var(--z-red);}
.hero .sub{max-width:520px;margin:22px auto 0;position:relative;z-index:1;font-size:17px;}
.hero-ctas{display:flex;gap:14px;margin-top:34px;position:relative;z-index:1;flex-wrap:wrap;justify-content:center;}
.btn-primary{font-family:'Space Mono',monospace;font-weight:700;font-size:14px;letter-spacing:.06em;text-transform:uppercase;background:var(--z-red);color:var(--steel);padding:17px 30px;border-radius:999px;text-decoration:none;box-shadow:0 10px 30px rgba(232,38,47,0.35);transition:transform .15s ease;}
.btn-primary:hover{transform:translateY(-2px);}
.btn-ghost{font-family:'Space Mono',monospace;font-weight:700;font-size:14px;letter-spacing:.06em;text-transform:uppercase;background:transparent;color:var(--steel);padding:17px 30px;border-radius:999px;text-decoration:none;border:1px solid var(--line);transition:border-color .15s ease;}
.btn-ghost:hover{border-color:var(--steel);}
.hero-stats{display:flex;gap:36px;margin-top:56px;position:relative;z-index:1;flex-wrap:wrap;justify-content:center;}
.hstat b{display:block;font-family:'Anton',sans-serif;font-size:30px;line-height:1;}
.hstat span{font-family:'Space Mono',monospace;font-size:10.5px;color:var(--smoke);letter-spacing:.1em;text-transform:uppercase;}

/* ---------- GALLERY ---------- */
.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
.gallery-item{position:relative;border-radius:18px;overflow:hidden;aspect-ratio:3/4;border:1px solid var(--line);background:var(--carbon);}
.gallery-item img{width:100%;height:100%;object-fit:cover;display:block;filter:grayscale(.1) contrast(1.06) brightness(.94);transition:transform .5s ease, filter .5s ease;}
.gallery-item:hover img{transform:scale(1.06);filter:grayscale(0) contrast(1.08) brightness(1);}
.gallery-item::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg, transparent 45%, rgba(11,11,13,.82) 100%);pointer-events:none;}
.gallery-item .tag{position:absolute;left:16px;bottom:14px;z-index:1;font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--steel);}
@media (max-width:640px){.gallery{grid-template-columns:1fr 1fr;}.gallery-item:first-child{grid-column:1 / -1;aspect-ratio:16/9;}}

/* ---------- SECTION GENERIC ---------- */
section{padding:80px 0;border-bottom:1px solid var(--line);}
section:last-of-type{border-bottom:none;}
.shead{margin-bottom:42px;max-width:620px;}
.shead.center{margin-left:auto;margin-right:auto;text-align:center;}
.shead h2{font-size:clamp(28px,4.4vw,42px);margin-bottom:14px;}

/* ---------- BENEFITS ---------- */
.benefits{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:2px;background:var(--line);border-radius:16px;overflow:hidden;border:1px solid var(--line);}
.benefit{background:var(--carbon);padding:30px 26px;}
.benefit .ico{width:42px;height:42px;border-radius:12px;background:var(--ring);display:flex;align-items:center;justify-content:center;margin-bottom:18px;}
.benefit .ico span{font-family:'Space Mono',monospace;font-weight:700;font-size:16px;color:var(--void);}
.benefit h3{font-family:'Manrope',sans-serif;font-weight:800;text-transform:none;font-size:17px;margin-bottom:8px;}
.benefit p{font-size:14px;}

/* ---------- PLANS ---------- */
.plans{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:22px;}
.plan{background:var(--carbon);border:1px solid var(--line);border-radius:20px;padding:34px 30px;position:relative;overflow:hidden;}
.plan.featured{border-color:var(--z-red);background:linear-gradient(160deg, var(--carbon), var(--carbon-2));}
.plan.featured::before{content:'MAIS ESCOLHIDO';position:absolute;top:22px;right:-38px;transform:rotate(45deg);background:var(--z-red);color:var(--steel);font-family:'Space Mono',monospace;font-size:10px;font-weight:700;letter-spacing:.1em;padding:5px 44px;}
.plan-tag{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--ignition);margin-bottom:6px;}
.plan h3{font-size:30px;margin-bottom:18px;}
.price{display:flex;align-items:baseline;gap:4px;margin-bottom:6px;}
.price .cur{font-family:'Manrope',sans-serif;font-weight:800;font-size:20px;color:var(--steel);}
.price .num{font-family:'Anton',sans-serif;font-size:56px;line-height:1;}
.price .cents{font-family:'Manrope',sans-serif;font-weight:800;font-size:20px;color:var(--smoke);}
.price-note{font-family:'Space Mono',monospace;font-size:12px;color:var(--smoke);margin-bottom:24px;}
.plan-list{list-style:none;margin:0 0 28px;padding:0;display:flex;flex-direction:column;gap:12px;}
.plan-list li{display:flex;gap:10px;align-items:flex-start;font-size:14.5px;color:var(--steel);}
.check{flex-shrink:0;width:19px;height:19px;border-radius:50%;border:1.5px solid var(--z-red);display:flex;align-items:center;justify-content:center;margin-top:1px;}
.check::after{content:'';width:8px;height:5px;border-left:2px solid var(--z-red);border-bottom:2px solid var(--z-red);transform:rotate(-45deg) translateY(-1px);}
.plan-list .note{color:var(--smoke);font-size:12px;padding-left:29px;margin-top:-6px;}
.plan-cash{font-family:'Space Mono',monospace;font-size:12.5px;color:var(--smoke);background:var(--void);border:1px dashed var(--line);border-radius:10px;padding:10px 14px;margin-bottom:22px;}
.plan-cash b{color:var(--steel);}
.plan-cta{display:block;text-align:center;font-family:'Space Mono',monospace;font-weight:700;font-size:13.5px;letter-spacing:.06em;text-transform:uppercase;background:var(--z-red);color:var(--steel);padding:15px;border-radius:999px;text-decoration:none;}
.plan.featured .plan-cta{box-shadow:0 10px 28px rgba(232,38,47,0.35);}
.plan:not(.featured) .plan-cta{background:transparent;border:1px solid var(--line);color:var(--steel);}

/* ---------- UNITS RING ---------- */
.units-wrap{display:flex;align-items:center;gap:56px;flex-wrap:wrap;}
.units-ring{position:relative;width:230px;height:230px;flex-shrink:0;margin:0 auto;}
.units-ring svg{width:100%;height:100%;}
.units-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
.units-center .num{font-family:'Anton',sans-serif;font-size:46px;line-height:1;}
.units-center .lbl{font-family:'Space Mono',monospace;font-size:10px;color:var(--smoke);letter-spacing:.12em;margin-top:4px;}
.units-list{display:grid;grid-template-columns:1fr 1fr;gap:14px 28px;flex:1;min-width:260px;}
.units-list div{display:flex;align-items:center;gap:10px;}
.units-list .name{font-family:'Manrope',sans-serif;font-weight:700;font-size:14.5px;color:var(--steel);}
.dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}

/* ---------- HOURS / INFO STRIP ---------- */
.info-strip{display:flex;flex-wrap:wrap;gap:2px;background:var(--line);border-radius:16px;overflow:hidden;border:1px solid var(--line);}
.info-cell{flex:1;min-width:180px;background:var(--carbon);padding:26px;text-align:center;}
.info-cell .k{font-family:'Space Mono',monospace;font-size:11px;color:var(--smoke);letter-spacing:.1em;text-transform:uppercase;margin-bottom:8px;}
.info-cell .v{font-family:'Space Mono',monospace;font-size:19px;color:var(--steel);font-weight:700;}

/* ---------- FINAL CTA ---------- */
.final{text-align:center;position:relative;overflow:hidden;padding:100px 24px;}
.final::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 30%, rgba(232,38,47,0.20), transparent 55%);pointer-events:none;}
.final .ring-hero{width:110px;height:110px;margin-bottom:20px;}
.final .ring-hero .z-mark{font-size:44px;}
.final h2{font-size:clamp(30px,5.5vw,54px);position:relative;z-index:1;max-width:640px;margin:0 auto 16px;}
.final p{max-width:460px;margin:0 auto 34px;position:relative;z-index:1;font-size:16px;}
.final .btn-primary{position:relative;z-index:1;}

/* ---------- FOOTER ---------- */
footer{padding:44px 0;}
.foot-in{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px;}
.foot-brand{display:flex;align-items:center;gap:10px;}
.foot-links{display:flex;gap:22px;flex-wrap:wrap;}
.foot-links a{font-family:'Space Mono',monospace;font-size:12px;color:var(--smoke);text-decoration:none;letter-spacing:.04em;}
.foot-links a:hover{color:var(--steel);}
footer .copy{font-family:'Space Mono',monospace;font-size:11px;color:var(--smoke);opacity:.55;text-align:center;margin-top:30px;}

/* ---------- WHATSAPP FLOATING BUTTON ---------- */
.wa-float{position:fixed;bottom:22px;right:22px;z-index:60;background:var(--z-red);width:58px;height:58px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 10px 30px rgba(232,38,47,0.45);text-decoration:none;}
.wa-float svg{width:28px;height:28px;}

@media (max-width:640px){
  .hero{min-height:92vh;padding:90px 20px 56px;}
  .hero-stats{gap:26px;}
  section{padding:60px 0;}
  .units-wrap{gap:34px;}
  .foot-in{flex-direction:column;align-items:flex-start;}
}
</style>
</head>
